{
  "name": "isumoa",
  "version": "0.4.3",
  "description": "이수모아 — 법정교육 이수증 종합 플랫폼",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning server/src/index.ts",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "verify:desktop": "node --disable-warning=ExperimentalWarning scripts/verify-windows-desktop.ts",
    "samples": "node scripts/make-sample-roster.ts",
    "release": "node --disable-warning=ExperimentalWarning scripts/release.ts",
    "samples:certs": "node scripts/make-sample-certificates.ts",
    "samples:forms": "node scripts/make-sample-forms.ts",
    "brand": "node --disable-warning=ExperimentalWarning scripts/brand/make-brand.ts",
    "media:screens": "node --disable-warning=ExperimentalWarning scripts/media/screenshots.ts",
    "media:promo": "node --disable-warning=ExperimentalWarning scripts/media/promo.ts",
    "eval": "node --disable-warning=ExperimentalWarning scripts/eval-ocr.ts",
    "restore": "node --disable-warning=ExperimentalWarning scripts/restore.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "@tesseract.js-data/kor": "^1.0.0",
    "archiver": "^8.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "iconv-lite": "^0.7.3",
    "kordoc": "4.24.1",
    "kysely": "^0.29.7",
    "pdf-lib": "^1.17.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/noto-serif-kr": "^5.3.1",
    "@napi-rs/canvas": "^1.0.13",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.61.0",
    "markdown-it": "14.3.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5",
    "wanted-sans": "1.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "kordoc": {
      "zod": "$zod"
    }
  }
}
